
{
  "include": ["src", "tests"],
  "exclude": [
    "**/__pycache__",
    "**/.pytest_cache",
    "**/.ruff_cache",
    "**/.venv",
    "**/node_modules"
  ],
  "typeCheckingMode": "strict",
  "executionEnvironments": [
    {
      "root": "tests",
      "extraPaths": ["src"],
      "reportArgumentType": "none"
    },
    {
      "root": "src",
      "extraPaths": ["src"]
    }
  ]
}
